############################################################
> # ADVANCED CLIENT STRESS & SUBJECTIVE DISTRESS MODEL
  > # Mental Health Counseling Computational Modeling Project
  > ############################################################
> 
  > # 1. LOAD PACKAGES
  > 
  > library(ggplot2)
> library(gganimate)
> library(gifski)
> library(transformr)
> 
  > set.seed(123)
> 
  > ############################################################
> # 2. CREATE SIMULATED CLIENT DATA
  > ############################################################
> 
  > n <- 1000
  > 
    > clients <- data.frame(
      +     sleep_hours = runif(n, 3, 10),
      +     work_stress = runif(n, 0, 10),
      +     social_support = runif(n, 0, 10),
      +     exercise = runif(n, 0, 10),
      +     coping = runif(n, 0, 10),
      +     stressful_events = runif(n, 0, 10),
      +     previous_stress = runif(n, 0, 10)
      + )
    > 
      > # Generate stress using weighted variables,
      > # nonlinear effects, and interactions.
      > 
      > clients$true_stress <-
        +     45 +
        +     3.0 * (8 - clients$sleep_hours) +
        +     5.0 * (clients$work_stress - 5) +
        +     3.0 * (5 - clients$social_support) +
        +     1.5 * (5 - clients$exercise) +
        +     3.0 * (5 - clients$coping) +
        +     4.5 * (clients$stressful_events - 3) +
        +     3.0 * (clients$previous_stress - 5) +
        +     0.5 * clients$work_stress *
        +     (10 - clients$coping) +
        +     rnorm(n, 0, 5)
      > 
        > # Keep stress within a 0-100 range.
        > 
        > clients$true_stress <- pmin(
          +     100, pmax(0, clients$true_stress)
          + )
        > 
          > # Subjective distress is generated as a related,
          > # but separate, outcome.
          > 
          > clients$distress <- pmin(
            +     100,
            +     pmax(
              +         0,
              +         8 + 0.82 * clients$true_stress +
                +             rnorm(n, 0, 6)
              +     )
            + )
          > 
            > ############################################################
          > # 3. DIVIDE DATA INTO TRAINING AND TESTING GROUPS
            > ############################################################
          > 
            > train_index <- sample(
              +     1:n,
              +     size = 0.80 * n
              + )
            > 
              > training_data <- clients[train_index, ]
              > testing_data <- clients[-train_index, ]
              > 
                > ############################################################
              > # 4. BUILD ADVANCED STRESS PREDICTION MODEL
                > ############################################################
              > 
                > stress_model <- lm(
                  +     true_stress ~
                    +         sleep_hours +
                    +         work_stress +
                    +         social_support +
                    +         exercise +
                    +         coping +
                    +         stressful_events +
                    +         previous_stress +
                    +         I(sleep_hours^2) +
                    +         I(work_stress * coping),
                  +     data = training_data
                  + )
                > 
                  > # Predict stress in the testing group.
                  > 
                  > testing_data$predicted_stress <- predict(
                    +     stress_model,
                    +     newdata = testing_data
                    + )
                  > 
                    > testing_data$predicted_stress <- pmin(
                      +     100,
                      +     pmax(0, testing_data$predicted_stress)
                      + )
                    > 
                      > ############################################################
                    > # 5. BUILD SUBJECTIVE DISTRESS PREDICTION MODEL
                      > ############################################################
                    > 
                      > distress_model <- lm(
                        +     distress ~ true_stress,
                        +     data = training_data
                        + )
                      > 
                        > # Use predicted stress to estimate distress.
                        > 
                        > testing_data$predicted_distress <- predict(
                          +     distress_model,
                          +     newdata = data.frame(
                            +         true_stress = testing_data$predicted_stress
                            +     )
                          + )
                        > 
                          > testing_data$predicted_distress <- pmin(
                            +     100,
                            +     pmax(0, testing_data$predicted_distress)
                            + )
                          > 
                            > ############################################################
                          > # 6. EVALUATE MODEL PERFORMANCE
                            > ############################################################
                          > 
                            > rmse <- function(actual, predicted) {
                              +     sqrt(mean((actual - predicted)^2))
                              + }
                            > 
                              > r_squared <- function(actual, predicted) {
                                +     1 - sum((actual - predicted)^2) /
                                  +         sum((actual - mean(actual))^2)
                                + }
                              > 
                                > cat("\nSTRESS MODEL PERFORMANCE\n")
                              
                              STRESS MODEL PERFORMANCE
                              > 
                                > cat(
                                  +     "Stress RMSE:",
                                  +     round(
                                    +         rmse(
                                      +             testing_data$true_stress,
                                      +             testing_data$predicted_stress
                                      +         ), 2
                                    +     ), "\n"
                                  + )
                              Stress RMSE: 6.66 
                              > 
                                > cat(
                                  +     "Stress R-squared:",
                                  +     round(
                                    +         r_squared(
                                      +             testing_data$true_stress,
                                      +             testing_data$predicted_stress
                                      +         ), 3
                                    +     ), "\n"
                                  + )
                              Stress R-squared: 0.94 
                              > 
                                > cat("\nDISTRESS MODEL PERFORMANCE\n")
                              
                              DISTRESS MODEL PERFORMANCE
                              > 
                                > cat(
                                  +     "Distress RMSE:",
                                  +     round(
                                    +         rmse(
                                      +             testing_data$distress,
                                      +             testing_data$predicted_distress
                                      +         ), 2
                                    +     ), "\n"
                                  + )
                              Distress RMSE: 7.93 
                              > 
                                > cat(
                                  +     "Distress R-squared:",
                                  +     round(
                                    +         r_squared(
                                      +             testing_data$distress,
                                      +             testing_data$predicted_distress
                                      +         ), 3
                                    +     ), "\n"
                                  + )
                              Distress R-squared: 0.881 
                              > 
                                > ############################################################
                              > # 7. DISPLAY MODEL COEFFICIENTS
                                > ############################################################
                              > 
                                > cat("\nSTRESS MODEL COEFFICIENTS\n")
                              
                              STRESS MODEL COEFFICIENTS
