                                > ############################################################
                              > # 8. SIMULATE ONE CLIENT OVER 60 DAYS
                                > ############################################################
                              > 
                                > days <- 60
                              > 
                                > client_path <- data.frame(
                                  +     day = 1:days
                                  + )
                              > 
                                > # Create changing client circumstances.
                                > 
                                > client_path$sleep_hours <-
                                +     7.2 + sin((1:days) / 6) +
                                +     rnorm(days, 0, 0.4)
                              > 
                                > client_path$work_stress <-
                                +     5 + 2 * sin((1:days) / 5) +
                                +     rnorm(days, 0, 0.6)
                              > 
                                > client_path$social_support <-
                                +     6 + 1.5 * cos((1:days) / 8) +
                                +     rnorm(days, 0, 0.5)
                              > 
                                > client_path$exercise <-
                                +     5 + 2 * sin((1:days) / 9) +
                                +     rnorm(days, 0, 0.5)
                              > 
                                > client_path$coping <-
                                +     5 + 2 * cos((1:days) / 10) +
                                +     rnorm(days, 0, 0.5)
                              > 
                                > client_path$stressful_events <-
                                +     4 + 2 * sin((1:days) / 4) +
                                +     rnorm(days, 0, 0.5)
                              > 
                                > client_path$previous_stress <-
                                +     5 + 2 * sin((1:days) / 7)
                              > 
                                > # Keep variables within reasonable limits.
                                > 
                                > variables <- c(
                                  +     "sleep_hours",
                                  +     "work_stress",
                                  +     "social_support",
                                  +     "exercise",
                                  +     "coping",
                                  +     "stressful_events",
                                  +     "previous_stress"
                                  + )
                              > 
                                > client_path[variables] <- lapply(
                                  +     client_path[variables],
                                  +     function(x) pmin(10, pmax(0, x))
                                  + )
                              > 
                                > ############################################################
                              > # 9. PREDICT THE CLIENT'S STRESS AND DISTRESS
                                > ############################################################
                              > 
                                > client_path$predicted_stress <- predict(
                                  +     stress_model,
                                  +     newdata = client_path
                                  + )
                              > 
                                > client_path$predicted_stress <- pmin(
                                  +     100,
                                  +     pmax(0, client_path$predicted_stress)
                                  + )
                              > 
                                > client_path$predicted_distress <- predict(
                                  +     distress_model,
                                  +     newdata = data.frame(
                                    +         true_stress = client_path$predicted_stress
                                    +     )
                                  + )
                              > 
                                > client_path$predicted_distress <- pmin(
                                  +     100,
                                  +     pmax(0, client_path$predicted_distress)
                                  + )
                              > 
                                > ############################################################
                              > # 10. CREATE ANIMATION DATA
                                > ############################################################
                              > 
                                > animation_data <- rbind(
                                  +     data.frame(
                                    +         day = client_path$day,
                                    +         score = client_path$predicted_stress,
                                    +         category = "Predicted Client Stress"
                                    +     ),
                                  +     data.frame(
                                    +         day = client_path$day,
                                    +         score = client_path$predicted_distress,
                                    +         category = "Predicted Subjective Distress"
                                    +     )
                                  + )
                              > 
                                > ############################################################
                              > # 11. CREATE ADVANCED ANIMATED GRAPH
                                > ############################################################
                              > 
                                > stress_animation <- ggplot(
                                  +     animation_data,
                                  +     aes(
                                    +         x = day,
                                    +         y = score,
                                    +         color = category,
                                    +         group = category
                                    +     )
                                  + ) +
                                +     
                                +     geom_hline(
                                  +         yintercept = 70,
                                  +         linetype = "dashed",
                                  +         color = "gray50",
                                  +         linewidth = 0.8
                                  +     ) +
                                +     
                                +     geom_line(
                                  +         linewidth = 1.5
                                  +     ) +
                                +     
                                +     geom_point(
                                  +         size = 2
                                  +     ) +
                                +     
                                +     scale_color_manual(
                                  +         values = c(
                                    +             "Predicted Client Stress" = "#E76F51",
                                    +             "Predicted Subjective Distress" = "#457B9D"
                                    +         )
                                  +     ) +
                                +     
                                +     scale_x_continuous(
                                  +         limits = c(1, days),
                                  +         breaks = seq(0, 60, 10)
                                  +     ) +
                                +     
                                +     scale_y_continuous(
                                  +         limits = c(0, 100),
                                  +         breaks = seq(0, 100, 10)
                                  +     ) +
                                +     
                                +     labs(
                                  +         title = "CLIENT STRESS PREDICTION SYSTEM",
                                  +         subtitle = "Simulated Client Progress | Day {frame_along}",
                                  +         x = "Time (Days)",
                                  +         y = "Predicted Score (0-100)",
                                  +         color = "Prediction",
                                  +         caption = paste(
                                    +             "Dashed line = illustrative high-score threshold.",
                                    +             "Synthetic demonstration data; not a clinical assessment."
                                    +         )
                                  +     ) +
                                +     
                                +     theme_minimal(base_size = 14) +
                                +     
                                +     theme(
                                  +         plot.title = element_text(
                                    +             face = "bold",
                                    +             size = 20
                                    +         ),
                                  +         plot.subtitle = element_text(size = 13),
                                  +         legend.position = "bottom",
                                  +         panel.grid.minor = element_blank()
                                  +     ) +
                                +     
                                +     transition_reveal(day)
                              > 
                                > ############################################################
                              > # 12. EXPORT ANIMATED GIF
                                > ############################################################
                              > 
                                > animate(
                                  +     stress_animation,
                                  +     nframes = 120,
                                  +     fps = 12,
                                  +     width = 1200,
                                  +     height = 750,
                                  +     renderer = gifski_renderer(
                                    +         "client_stress_prediction.gif"
                                    +     )
                                  + )